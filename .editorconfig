# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp}]
indent_style = space
indent_size = 4

[*.{cmake,cmake.in,CMakeLists.txt}]
indent_style = space
indent_size = 4

[*.{md}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
